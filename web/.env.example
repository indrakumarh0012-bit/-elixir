# Server-side Groq key (production web host). Set in Vercel/Netlify dashboard.
GROQ_API_KEY=

# Required when building the Android APK — your hosted app URL (no trailing slash).
# Example: https://smart-elixir.vercel.app
VITE_API_BASE_URL=

# Local development only (optional). Web production uses /api/groq proxy instead.
VITE_GROQ_API_KEY=
